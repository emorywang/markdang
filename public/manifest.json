{
  "name": "MarkDang",
  "version": "1.0.1",
  "version_name": "1.0.1",
  "description": "__MSG_description__",
  "default_locale": "en",
  "manifest_version": 3,
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "MarkDang",
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "assets/background.js"
  },
  "permissions": [
    "storage"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*",
        "assets/mermaid.js",
        "icons/icon-32.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*/*.md",
        "*://*/*.md?*",
        "*://*/*.mdx",
        "*://*/*.mdx?*",
        "*://*/*.mkd",
        "*://*/*.mkd?*",
        "*://*/*.txt",
        "*://*/*.txt?*",
        "*://*/*.markdown",
        "*://*/*.markdown?*",
        "*://*/*.MD",
        "*://*/*.MD?*",
        "*://*/*.MDX",
        "*://*/*.MDX?*",
        "*://*/*.MKD",
        "*://*/*.MKD?*",
        "*://*/*.TXT",
        "*://*/*.TXT?*",
        "*://*/*.MARKDOWN",
        "*://*/*.MARKDOWN?*",
        "file:///*"
      ],
      "js": [
        "assets/boot.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*/*.md",
        "*://*/*.md?*",
        "*://*/*.mdx",
        "*://*/*.mdx?*",
        "*://*/*.mkd",
        "*://*/*.mkd?*",
        "*://*/*.txt",
        "*://*/*.txt?*",
        "*://*/*.markdown",
        "*://*/*.markdown?*",
        "*://*/*.MD",
        "*://*/*.MD?*",
        "*://*/*.MDX",
        "*://*/*.MDX?*",
        "*://*/*.MKD",
        "*://*/*.MKD?*",
        "*://*/*.TXT",
        "*://*/*.TXT?*",
        "*://*/*.MARKDOWN",
        "*://*/*.MARKDOWN?*",
        "file:///*"
      ],
      "js": [
        "assets/content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "commands": {
    "toggleSide": {
      "description": "__MSG_toggleSide__",
      "suggested_key": {
        "default": "Alt+Shift+B"
      }
    },
    "toggleCentered": {
      "description": "__MSG_toggleCentered__",
      "suggested_key": {
        "default": "Alt+Shift+C"
      }
    },
    "toggleRefresh": {
      "description": "__MSG_toggleRefresh__",
      "suggested_key": {
        "default": "Alt+Shift+R"
      }
    },
    "toggleTheme": {
      "description": "__MSG_toggleTheme__",
      "suggested_key": {
        "default": "Alt+Shift+T"
      }
    }
  },
  "author": "MarkDang",
  "minimum_chrome_version": "110"
}
