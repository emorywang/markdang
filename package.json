{
  "name": "markdang",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
    "test:e2e": "node scripts/e2e.mjs && node scripts/test-ux.mjs && node scripts/test-options.mjs && node scripts/test-regressions.mjs && node scripts/test-i18n.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "check": "npm run typecheck && npm run test:unit && npm run build",
    "zip": "npm run build && node scripts/zip.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "store:screenshots": "node scripts/store-screenshots.mjs"
  },
  "dependencies": {
    "@mdit/plugin-alert": "^0.22.1",
    "@traptitech/markdown-it-katex": "^3.6.0",
    "dompurify": "^3.4.16",
    "highlight.js": "^11.11.0",
    "katex": "^0.16.47",
    "markdown-it": "^14.1.0",
    "markdown-it-abbr": "^2.0.0",
    "markdown-it-container": "^4.0.0",
    "markdown-it-deflist": "^4.0.0",
    "markdown-it-emoji": "^3.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-ins": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-multimd-table": "^4.2.3",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "mermaid": "^11.4.1",
    "pako": "^2.2.0",
    "preact": "^10.24.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/chrome": "^0.0.280",
    "@types/markdown-it": "^14.1.2",
    "@types/pako": "^2.0.4",
    "archiver": "^7.0.1",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^7.3.6"
  },
  "description": "码刻档 —— 在浏览器中舒适阅读 Markdown。无账号、无订阅、全功能开放。",
  "engines": {
    "node": ">=22.12.0"
  }
}
